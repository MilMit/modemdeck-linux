        if bands.is_empty() { return Err("Profile has no bands.".into()); }
        let object = self.manager.object(object_path).ok_or_else(|| "The modem disappeared from ModemManager.".to_string())?;
        let iface = gio::prelude::DBusObjectExt::interface(&object, MODEM_IFACE)
            .ok_or_else(|| "The generic 