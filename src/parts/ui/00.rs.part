use std::{cell::{Cell, RefCell}, collections::BTreeSet, rc::Rc, time::Duration};

use gio::prelude::*;
use gtk::prelude::*;

use crate::{
    apn,
    communications,
    diagnostics,
    drivers::DriverKind,
    history,
    i18n,
    model::{
        band_label, is_lte_mm_band, is_lte_tdd_band, is_lte_tdd_mm_band, ModemInfo,
        RadioSignal, ServingCellInfo,
    },
    modem_manager::ModemManagerClient,
    power,
    profiles,
    runtime_status,
    safety,
    settings::{self, Settings},
    traffic,
    updates,
};


pub fn build(app: &gtk::Application) {
    load_css();

    let window = gtk::ApplicationWindow::builder()
        .application(app)
        .title("ModemDeck")
        .default_width(900)
        .default_height(720)
        .build();

    let root = gtk::Box::new(gtk::Orientation::Vertical, 0);
    root.add_css_class("app-root");

    let header = gtk::HeaderBar::new();
    let brand_title = gtk::Box::new(gtk::Orientation::Vertical, 0);
    brand_title.set_valign(gtk::Align::Center);
    let title = gtk::Label::new(Some("ModemDeck"));
    title.add_css_class("title");
    let brand_subtitle = gtk::Label::new(Some("by MilMit • milmit.net"));
    brand_subtitle.add_css_class("brand-subtitle");
    brand_title.append(&title);
    brand_title.append(&brand_subtitle);
    header.set_title_widget(Some(&brand_title));

    let refresh = gtk::Button::builder()
        .icon_name("view-refresh-symbolic")
        .tooltip_text(i18n::tr("refresh"))
        .build();
    header.pack_end(&refresh);

    let preferences = gtk::Button::builder()
        .icon_name("emblem-system-symbolic")
        .tooltip_text(i18n::tr("preferences"))
        .build();
    header.pack_end(&preferences);

    let diagnostics_button = gtk::Button::builder()
        .icon_name("document-save-symbolic")
        .tooltip_text(i18n::tr("diagnostics"))
        .build();
    header.pack_end(&diagnostics_button);

    let about_button = gtk::Button::builder()
        .icon_name("help-about-symbolic")
        .tooltip_text(i18n::tr("about"))
        .build();
    header.pack_end(&about_button);

    let supported_button = gtk::Button::builder()
        .icon_name("network-cellular-symbolic")
        .tooltip_text(i18n::tr("supported_modems"))
        .build();
    header.pack_end(&supported_button);

    let update_button = gtk::Button::builder()
        .icon_name("software-update-available-symbolic")
        .tooltip_text(i18n::tr("check_updates"))
        .build();
    header.pack_end(&update_button);

    let notes_button = gtk::Button::builder()
        .icon_name("view-list-symbolic")
        .tooltip_text(i18n::tr("release_notes"))
        .build();
    header.pack_end(&notes_button);

    let report_button = gtk::Button::builder()
        .icon_name("dialog-warning-symbolic")
        .tooltip_text(i18n::tr("report_problem"))
        .build();
    header.pack_end(&report_button);
    window.set_titlebar(Some(&header));

    let scroller = gtk::ScrolledWindow::builder()
        .hexpand(true)
        .vexpand(true)
        .build();
    let content = gtk::Box::new(gtk::Orientation::Vertical, 14);
    content.add_css_class("page-content");
    content.set_margin_top(20);
    content.set_margin_bottom(20);
    content.set_margin_start(20);
    content.set_margin_end(20);
    scroller.set_child(Some(&content));
    root.append(&scroller);

    let status = gtk::Label::new(None);
    status.set_xalign(0.0);
    status.add_css_class("dim-label");
    content.append(&status);

    let switcher = gtk::StackSwitcher::new();
    switcher.set_halign(gtk::Align::Start);
    content.append(&switcher);

    let stack = gtk::Stack::builder()
        .hexpand(true)
        .vexpand(true)
        .transition_type(gtk::StackTransitionType::Crossfade)
        .build();
    switcher.set_stack(Some(&stack));
    content.append(&stack);

    let brand_footer = gtk::Box::new(gtk::Orientation::Horizontal, 6);
    brand_footer.set_halign(gtk::Align::Center);
    brand_footer.add_css_class("brand-footer");
    let brand_footer_text = gtk::Label::new(Some("ModemDeck by MilMit •"));
    brand_footer_text.add_css_class("dim-label");
    let brand_link = gtk::LinkButton::with_label("https://milmit.net", "milmit.net");
    brand_link.add_css_class("brand-link");
    brand_footer.append(&brand_footer_text);
    brand_footer.append(&brand_link);
    content.append(&brand_footer);

    window.set_child(Some(&root));

    match ModemManagerClient::new() {
        Ok(client) => {
            let client = Rc::new(client);
            let app_settings = Settings::load();
            let signal_refresh_rate = app_settings.normalized_refresh_seconds();
            client.ensure_signal_updates(signal_refresh_rate);
            match client.recover_pending_band_change() {
                Ok(Some(message)) => status.set_text(&message),
                Ok(None) => {},
                Err(error) => status.set_text(&format!("Safety recovery note: {error}")),
            }
            if app_settings.restore_profile_on_startup {
                restore_active_profile(&client);
            }
            render_modems(&stack, &switcher, &status, &client.modems(), &client);

            {
                let client = client.clone();
                let stack = stack.clone();
                let switcher = switcher.clone();
                let status = status.clone();
                refresh.connect_clicked(move |_| {
                    client.ensure_signal_updates(signal_refresh_rate);
                    render_modems(&stack, &switcher, &status, &client.modems(), &client);
                });
            }

            {
                let client = client.clone();
                let stack = stack.clone();
                let switcher = switcher.clone();
                let status = status.clone();
                let manager = client.manager().clone();
                manager.connect_object_added(move |_, object| {
                    client.ensure_signal_updates_for_object(object, signal_refresh_rate);
                    render_modems(&stack, &switcher, &status, &client.modems(), &client);
                });
            }
            {
                let client = client.clone();
                let stack = stack.clone();
                let switcher = switcher.clone();
                let status = status.clone();
                let manager = client.manager().clone();
                manager.connect_object_removed(move |_, _| {
                    render_modems(&stack, &switcher, &status, &client.modems(), &client);
                });
            }

            // Live D-Bus property updates must not rebuild the entire GTK tree.
            // Rebuilding the stack on every signal reading caused visible flicker,
            // reset scroll position and made controls feel as if they were refreshing.
            // Coalesce bursts of D-Bus events and patch only the live labels/bars.
            {
                let cli