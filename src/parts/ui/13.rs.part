    let background = gtk::Switch::builder().active(settings.background_monitor).build();
    background.add_css_class("compact-switch"); background.set_valign(gtk::Align::Center); background.set_size_request(48, 28);
    root.append(&preference_row("Background monitor", "Keeps the lightweight event-driven modem monitor running for the top-bar indicator, usage accounting and profile restore.", &background));

