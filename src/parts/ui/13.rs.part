    root.append(&preference_row("Notifications", "Notify on meaningful mobile-network changes while the monitor is running.", &notifications));

    let restore_profile = gtk::Switch::builder().active(settings.restore_profile_on_startup).build();
    restore_profile.add_css_class("compact-switch"); restore_prof